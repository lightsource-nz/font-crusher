    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) crush (context creation test)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/Users/aful018/tools/w64devkit/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "disable halting on thread management signals",
                    "text": "handle SIGUSR1 SIGUSR2 noprint pass",
                    "ignoreFailures": false
                },
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                },
                {
                    "description": "Avoid iconv errors when printing locals (target-charset must be a total encoding)",
                    "text": "-gdb-set target-charset ISO-8859-1",
                    "ignoreFailures": true
                },
                {
                    "description": "Force host-charset to a name w64devkit's iconv recognizes (avoid CP65001 alias)",
                    "text": "-gdb-set host-charset UTF-8",
                    "ignoreFailures": true
                }
            ]
        },
        {
