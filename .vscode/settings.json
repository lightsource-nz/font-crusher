{
    //   NO ABSOLUTE PATHS -- this file used to name one developer's C:\Users\<name>\tools three
    // times over, which no second machine could satisfy.
    //
    //   the tool directory comes from the environment, set by light-env.ps1 from the gitignored
    // user.config.ps1 (or from its derived defaults). For it to be populated, start VS Code from
    // a shell that has dot-sourced it:
    //
    //     . $env:LIGHT_PATH/scripts/light-env.ps1
    //     code .
    //
    //   an unset variable expands to nothing and simply leaves that entry off PATH, so a
    // developer whose toolchain is already on PATH needs none of this. Building from the terminal
    // via scripts/build.ps1 does not depend on this file at all.
    "cmake.configurePreset": "user-crush-debug",
    "cmake.environment": {
        "PATH": "${env:LIGHT_W64DEVKIT_BIN};${env:PATH}"
    },
    "cmake.configureSettings": {
        //   sibling checkouts, against the workspace rather than the build tree: the old
        // "../../pico-sdk" was relative to wherever CMake was invoked from, which is only
        // correct for a build directory exactly one level down
        "PICO_SDK_PATH": "${workspaceFolder}/../pico-sdk",
        "LIGHT_PATH": "${workspaceFolder}/../light_framework_mk3"
    },
    "cmake.configureEnvironment": {
        "LIGHT_PATH": "${workspaceFolder}/../light_framework_mk3"
    },
    "terminal.integrated.env.windows": {
        "Path": "${env:LIGHT_W64DEVKIT_BIN};${env:PATH}",
        "PATH": "${env:LIGHT_W64DEVKIT_BIN};${env:PATH}"
    },
    "files.associations": {
        "crush.h": "c",
        "light.h": "c",
        "light_core_port.h": "c",
        "mod_crush_context.h": "c",
        "crush_context.h": "c",
        "crush_common.h": "c",
        "mod_crush_common.h": "c",
        "crush_module.h": "c",
        "crush_display.h": "c",
        "crush_render.h": "c",
        "crush_font.h": "c"
    }
}
